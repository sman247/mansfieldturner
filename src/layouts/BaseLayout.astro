---
import "../styles/global.css";

// Cloudflare Web Analytics site token — just the token, not the whole snippet;
// the layout builds the beacon tag around it below. Public by design (it ships
// in the built HTML). Leave empty to render nothing.
const CLOUDFLARE_ANALYTICS_TOKEN = "40c83f54743444118bed581a0c283797";

// Head props may arrive directly (.astro pages) or nested under `frontmatter`
// (Markdown pages that set `layout:`).
const { frontmatter } = Astro.props;
const props = frontmatter ?? Astro.props;

const SITE_NAME = "Mansfield Turner";
const HOME_TITLE =
	"Mansfield Turner — Architecture, Set Design, Exhibition & Furniture Design, London";
const HOME_DESCRIPTION =
	"Mansfield Turner is a London design partnership working across architecture, set design, exhibition design, furniture and creative consulting.";

// Default share image: the wordmark card in public/. Absolute, per OG spec.
const OG_IMAGE_DEFAULT = new URL("/og-image.png", Astro.site).href;

const {
	title,
	description,
	ogType = "website",
	noindex = false,
	ogImage = OG_IMAGE_DEFAULT,
	ogImageAlt = "Mansfield Turner",
	ogImageWidth = 1200,
	ogImageHeight = 630,
} = props;

const resolvedTitle = title ?? HOME_TITLE;
const resolvedDescription = description ?? HOME_DESCRIPTION;
// Absolute, trailing-slash canonical built from `site` + the served path.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const isHome = Astro.url.pathname === "/";
// Organization structured data — homepage only.
const organizationLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "Mansfield Turner",
	url: "https://mansfieldturner.com",
	description:
		"Design partnership working across architecture, set design, exhibition design, furniture and creative consulting.",
	founder: [
		{ "@type": "Person", name: "Sean Mansfield" },
		{ "@type": "Person", name: "Edward Turner" },
	],
	address: {
		"@type": "PostalAddress",
		addressLocality: "London",
		addressCountry: "GB",
	},
	sameAs: ["https://www.instagram.com/mansfield.turner"],
	knowsAbout: [
		"Architecture",
		"Set design",
		"Exhibition design",
		"Furniture design",
		"Creative consulting",
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>{resolvedTitle}</title>
		<meta name="description" content={resolvedDescription} />
		{
			noindex ? (
				<meta name="robots" content="noindex" />
			) : (
				<link rel="canonical" href={canonical} />
			)
		}

		<meta property="og:title" content={resolvedTitle} />
		<meta property="og:description" content={resolvedDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />

		{
			isHome && (
				<script
					type="application/ld+json"
					is:inline
					set:html={JSON.stringify(organizationLd)}
				/>
			)
		}
	</head>
	<body>
        <main class="content">
            <slot />
        </main>

		<script>
			// Drop an image at a random spot below the text, at the consistent
			// size set by the .project-image CSS rule.
			function dropImage(src: string): HTMLImageElement {
				const gap = 12;
				const content = document.querySelector<HTMLElement>(".content");
				const rect = content
					? content.getBoundingClientRect()
					: ({ bottom: 0 } as DOMRect);
				const vw = window.innerWidth;
				const vh = window.innerHeight;

				const img = document.createElement("img");
				img.className = "project-image";
				// Decorative overlays behind the text: empty alt so screen
				// readers skip them rather than announcing the filename.
				img.alt = "";
				img.style.visibility = "hidden";

				let placed = false;
				const place = () => {
					if (placed) return;
					placed = true;
					const w = img.offsetWidth;
					const h = img.offsetHeight;
					const minX = gap;
					const maxX = vw - w - gap;
					const minY = rect.bottom + gap;
					const maxY = vh - h - gap;
					img.style.left = minX + Math.random() * Math.max(0, maxX - minX) + "px";
					img.style.top = minY + Math.random() * Math.max(0, maxY - minY) + "px";
					img.style.visibility = "visible";
				};
				img.addEventListener("load", place);
				document.body.appendChild(img);
				img.src = src;
				if (img.complete && img.naturalWidth) place();
				return img;
			}

			// The "m t" logo: on load, show a random one of its images. Its clicks
			// then start with the one NOT shown on load and alternate from there.
			const logo = document.querySelector<HTMLElement>(".logo");
			if (logo) {
				const list = (logo.dataset.images ?? "")
					.split(",")
					.map((s) => s.trim())
					.filter(Boolean);
				if (list.length) {
					const start = Math.floor(Math.random() * list.length);
					dropImage(list[start]);
					let i = start + 1;
					logo.addEventListener("click", () => {
						dropImage(list[i % list.length]);
						i++;
					});
				}
			}

			// Projects: each click drops an image on top as a new layer, stacking
			// them up. A project can carry a single `data-image`, or a
			// comma-separated `data-images` list that the clicks cycle through.
			document.querySelectorAll<HTMLElement>(".project[data-image], .project[data-images]").forEach((el) => {
				const list = (el.dataset.images ?? el.dataset.image ?? "")
					.split(",")
					.map((s) => s.trim())
					.filter(Boolean);
				let i = 0;
				el.addEventListener("click", () => {
					if (!list.length) return;
					dropImage(list[i % list.length]);
					i++;
				});
			});

			// Contact: click "Contact" to reveal the emails beneath it.
			document.querySelectorAll(".contact-toggle").forEach((el) => {
				el.addEventListener("click", () => {
					const emails = document.querySelector(".contact-emails");
					if (emails) emails.classList.toggle("show");
				});
			});

			// Emails: the address lives in `data-email` (so Markdown can't turn it
			// into a mailto link) and is written in as plain, underlined text.
			// Click to copy to the clipboard; if the clipboard API is unavailable
			// (e.g. an insecure context), select the text so it can be copied by hand.
			document.querySelectorAll<HTMLElement>(".email").forEach((el) => {
				const email = el.dataset.email ?? "";
				el.textContent = email;
				el.addEventListener("click", async () => {
					try {
						await navigator.clipboard.writeText(email);
						el.classList.add("copied");
						setTimeout(() => el.classList.remove("copied"), 1500);
					} catch {
						const range = document.createRange();
						range.selectNodeContents(el);
						const sel = window.getSelection();
						sel?.removeAllRanges();
						sel?.addRange(range);
					}
				});
			});
		</script>

		{
			CLOUDFLARE_ANALYTICS_TOKEN && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={`{"token": "${CLOUDFLARE_ANALYTICS_TOKEN}"}`}
				/>
			)
		}
	</body>
</html>
